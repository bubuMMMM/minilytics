{
  "name": "minilytics",
  "version": "0.1.0",
  "private": true,
  "description": "Analytique web orient\u00e9e revenu, auto-h\u00e9berg\u00e9e sur Vercel + Neon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bubuMMMM/minilytics.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"vite\"",
    "dev:api": "node --experimental-strip-types scripts/dev-api.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/minify-tracker.mjs && node scripts/spa-shell.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/worker src/server src/dashboard src/shared api scripts/dev-api.ts",
    "check": "tsc --noEmit && eslint src/worker src/server src/dashboard src/shared api scripts/dev-api.ts",
    "test": "vitest run",
    "db:migrate:pg": "node scripts/migrate-pg.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "d3-geo": "^3.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "satori": "^0.63.2",
    "topojson-client": "^3.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "cobe": "^0.6.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "fflate": "$fflate"
  },
  "homepage": "https://github.com/bubuMMMM/minilytics",
  "bugs": {
    "url": "https://github.com/bubuMMMM/minilytics/issues"
  }
}
