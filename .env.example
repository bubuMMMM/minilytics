# Copiez ce fichier vers .env.local (ne le commitez jamais).
# DATABASE_URL pointe vers Neon (ou Postgres local). Ne l’utilisez pas pour un seed de démo en production.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Optionnel
# CRON_SECRET=
# X_BEARER_TOKEN=
# RESEND_API_KEY=
# REPORT_FROM_EMAIL=Minilytics <rapports@votre-domaine.com>
# GITHUB_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
